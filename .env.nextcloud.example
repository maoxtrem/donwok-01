# Copy this file to .env.nextcloud.local and replace the secret values.
MYSQL_PASSWORD=replace-with-a-strong-password
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-secret

# Local example. For the remote server, use its Tailscale hostname and https.
NEXTCLOUD_PUBLIC_HOST=localhost
NEXTCLOUD_PUBLIC_SCHEME=http
NEXTCLOUD_PUBLIC_URL=http://localhost/nextcloud
NEXTCLOUD_WEBROOT=/nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 nextcloud
ONLYOFFICE_PUBLIC_URL=http://localhost/onlyoffice/
