{% extends 'base.html.twig' %}

{% block title %}Donwok | Iniciar sesión{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="auth-card" aria-labelledby="login-title">
        <a class="back-link" href="{{ path('app_home') }}">← Volver al inicio</a>
        <div class="brand-lockup"><div class="brand-mark brand-mark-small">D</div><span>Donwok</span></div>
        <p class="eyebrow">Acceso interno</p>
        <h1 id="login-title">Iniciar sesión</h1>
        <p class="auth-copy">Ingresa con tu usuario para continuar.</p>

        {% if error %}
            <div class="alert alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" class="auth-form" data-native-submit="1">
            <label for="username">Usuario</label>
            <input id="username" type="text" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>

            <label for="password">Contraseña</label>
            <input id="password" type="password" name="_password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button button-primary button-full" type="submit">Entrar</button>
        </form>
    </section>
</main>
{% endblock %}
