{% extends 'base.html.twig' %}

{% block title %}Donwok | Editar orden #{{ order.orderNumber }}{% endblock %}

{% block body %}
<main class="orders-shell">
    <header class="dashboard-header orders-header">
        <a class="brand-lockup" href="{{ path('app_dashboard') }}">
            <div class="brand-mark brand-mark-mini">D</div><span>Donwok</span>
        </a>
        <a class="back-link" href="{{ path('app_orders') }}">← Volver a órdenes</a>
    </header>

    <section class="edit-order-card">
        <div class="orders-heading edit-order-heading">
            <div>
                <p class="eyebrow">Edición de orden</p>
                <h1>#{{ order.orderNumber }}</h1>
                <p>Los componentes se conservarán sin modificar en esta fase.</p>
            </div>
            {% if can_edit %}<span class="order-status status-en_preparacion">Bloqueada para ti</span>{% endif %}
        </div>

        {% if error %}
            <div class="alert alert-error">{{ error }}</div>
            <a class="button button-secondary" href="{{ path('app_orders') }}">Volver</a>
        {% else %}
            <form id="edit-order-form" class="edit-order-form">
                <label for="order-type">Tipo de pedido</label>
                <select id="order-type">
                    <option value="mesa"{% if order.orderType.value == 'mesa' %} selected{% endif %}>Para mesa</option>
                    <option value="llevar"{% if order.orderType.value == 'llevar' %} selected{% endif %}>Para llevar</option>
                    <option value="domicilio"{% if order.orderType.value == 'domicilio' %} selected{% endif %}>Domicilio</option>
                </select>

                <div id="table-fields">
                    <label for="table-number">Número de mesa</label>
                    <input id="table-number" type="text" value="{{ order.tableNumber|default('') }}">
                </div>

                <div id="delivery-fields"{% if order.orderType.value != 'domicilio' %} hidden{% endif %}>
                    <label for="customer-name">Nombre del cliente</label>
                    <input id="customer-name" type="text" value="{{ order.customerName|default('') }}">
                    <label for="customer-phone">Teléfono</label>
                    <input id="customer-phone" type="text" value="{{ order.customerPhone|default('') }}">
                    <label for="delivery-address">Dirección</label>
                    <input id="delivery-address" type="text" value="{{ order.deliveryAddress|default('') }}">
                </div>

                <div class="edit-items-readonly edit-items-components">
                    <h2>Ítems y componentes</h2>
                    {% for item in order.items %}
                        <div class="editable-item" data-item-id="{{ item.id }}">
                            <strong>{{ item.quantity }} × {{ item.name }}</strong>
                            {% for component in item.components %}
                                <div class="component-editor" data-component-id="{{ component.id }}">
                                    <select data-component-product aria-label="Producto del componente">
                                        {% for product in products %}
                                            <option value="{{ product.id }}"{% if product.id == component.sourceProductId %} selected{% endif %}>{{ product.name }}</option>
                                        {% endfor %}
                                    </select>
                                    <input data-component-quantity type="text" value="{{ component.quantity }}" aria-label="Cantidad del componente">
                                    <span class="component-unit">{{ component.unit }}</span>
                                    <button class="component-action" type="button" data-component-update>Guardar</button>
                                    <button class="component-remove" type="button" data-component-remove aria-label="Quitar componente">×</button>
                                </div>
                            {% endfor %}
                            <div class="component-add">
                                <select data-add-product aria-label="Agregar producto">
                                    <option value="">Agregar componente...</option>
                                    {% for product in products %}<option value="{{ product.id }}">{{ product.name }}</option>{% endfor %}
                                </select>
                                <input data-add-quantity type="text" value="1.000" aria-label="Cantidad nueva">
                                <button class="component-action" type="button" data-component-add>Agregar</button>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <p id="edit-order-error" class="order-error" hidden></p>
                <div class="edit-actions">
                    <button id="cancel-edit" class="button button-secondary" type="button">Cancelar</button>
                    <button class="button button-primary" type="submit">Guardar cambios</button>
                </div>
            </form>
        {% endif %}
    </section>
</main>
{% endblock %}

{% block javascripts %}
{% if can_edit %}
<script>
    const orderType = document.getElementById('order-type');
    const tableFields = document.getElementById('table-fields');
    const deliveryFields = document.getElementById('delivery-fields');
    const errorBox = document.getElementById('edit-order-error');

    function updateDestinationFields() {
        tableFields.hidden = orderType.value !== 'mesa';
        deliveryFields.hidden = orderType.value !== 'domicilio';
    }

    orderType.addEventListener('change', updateDestinationFields);
    updateDestinationFields();

    document.getElementById('edit-order-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.hidden = true;

        const response = await fetch('{{ path('api_orders_update', {id: order.id}) }}', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                orderType: orderType.value,
                tableNumber: document.getElementById('table-number').value,
                customerName: document.getElementById('customer-name').value,
                customerPhone: document.getElementById('customer-phone').value,
                deliveryAddress: document.getElementById('delivery-address').value,
            }),
        });

        const result = await response.json();
        if (!response.ok) {
            errorBox.textContent = result.error || 'No fue posible guardar los cambios.';
            errorBox.hidden = false;
            return;
        }

        window.location.href = '{{ path('app_orders') }}';
    });

    document.getElementById('cancel-edit').addEventListener('click', async () => {
        await fetch('{{ path('api_orders_unlock', {id: order.id}) }}', { method: 'DELETE' });
        window.location.href = '{{ path('app_orders') }}';
    });

    async function componentRequest(url, method, payload = null) {
        const options = { method, headers: { 'Content-Type': 'application/json' } };
        if (payload) options.body = JSON.stringify(payload);
        const response = await fetch(url, options);
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'No fue posible actualizar el componente.');
        return result;
    }

    document.querySelectorAll('[data-component-update]').forEach((button) => {
        button.addEventListener('click', async () => {
            const component = button.closest('[data-component-id]');
            const item = button.closest('[data-item-id]');
            try {
                await componentRequest(`/api/orders/{{ order.id }}/items/${item.dataset.itemId}/components/${component.dataset.componentId}`, 'PATCH', {
                    productId: component.querySelector('[data-component-product]').value,
                    quantity: component.querySelector('[data-component-quantity]').value,
                });
                window.location.reload();
            } catch (error) {
                errorBox.textContent = error.message;
                errorBox.hidden = false;
            }
        });
    });

    document.querySelectorAll('[data-component-remove]').forEach((button) => {
        button.addEventListener('click', async () => {
            const component = button.closest('[data-component-id]');
            const item = button.closest('[data-item-id]');
            try {
                await componentRequest(`/api/orders/{{ order.id }}/items/${item.dataset.itemId}/components/${component.dataset.componentId}`, 'DELETE');
                window.location.reload();
            } catch (error) {
                errorBox.textContent = error.message;
                errorBox.hidden = false;
            }
        });
    });

    document.querySelectorAll('[data-component-add]').forEach((button) => {
        button.addEventListener('click', async () => {
            const item = button.closest('[data-item-id]');
            const product = item.querySelector('[data-add-product]');
            try {
                if (!product.value) throw new Error('Selecciona un producto para agregar.');
                await componentRequest(`/api/orders/{{ order.id }}/items/${item.dataset.itemId}/components`, 'POST', {
                    productId: product.value,
                    quantity: item.querySelector('[data-add-quantity]').value,
                });
                window.location.reload();
            } catch (error) {
                errorBox.textContent = error.message;
                errorBox.hidden = false;
            }
        });
    });
</script>
{% endif %}
{% endblock %}
