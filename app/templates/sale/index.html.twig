{% extends 'base.html.twig' %}

{% block title %}Donwok | Menú de venta{% endblock %}

{% block body %}
<main class="sale-shell">
    <header class="dashboard-header sale-header">
        <div class="dashboard-brand">
            <a class="brand-lockup" href="{{ path('app_dashboard') }}">
                <div class="brand-mark brand-mark-mini">D</div><span>Donwok</span>
            </a>
        </div>
        <a class="back-link" href="{{ path('app_dashboard') }}">← Panel operativo</a>
    </header>

    <div class="sale-layout">
        <section class="catalog-panel" aria-labelledby="sale-title">
            <div class="sale-heading">
                <div>
                    <p class="eyebrow">Menú de venta</p>
                    <h1 id="sale-title">Agrega productos al pedido</h1>
                </div>
                <span class="catalog-count">{{ products|length + composites|length }} disponibles</span>
            </div>

            {% if composites is not empty %}
                <h2 class="catalog-section-title">Compuestos</h2>
                <div class="catalog-grid">
                    {% for composite in composites %}
                        <button class="catalog-item" type="button" data-item-type="composite" data-item-id="{{ composite.id }}" data-item-name="{{ composite.name|e('html_attr') }}" data-item-price="{{ composite.price }}">
                            <span class="catalog-item-name">{{ composite.name }}</span>
                            <span class="catalog-item-meta">{{ composite.price|number_format(2, ',', '.') }}</span>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            <h2 class="catalog-section-title">Productos</h2>
            {% if products is not empty %}
                <div class="catalog-grid">
                    {% for product in products %}
                        <button class="catalog-item" type="button" data-item-type="product" data-item-id="{{ product.id }}" data-item-name="{{ product.name|e('html_attr') }}" data-item-price="{{ product.price }}">
                            <span class="catalog-item-name">{{ product.name }}</span>
                            <span class="catalog-item-meta">{{ product.price|number_format(2, ',', '.') }}</span>
                        </button>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">Todavía no hay productos activos en el catálogo.</div>
            {% endif %}
        </section>

        <aside class="order-panel" aria-labelledby="cart-title">
            <div class="order-panel-heading">
                <div>
                    <p class="eyebrow">Pedido actual</p>
                    <h2 id="cart-title">Ítems seleccionados</h2>
                </div>
                <span id="cart-count" class="cart-count">0</span>
            </div>
            <div class="order-options">
                <label for="order-type">Tipo de pedido</label>
                <select id="order-type">
                    <option value="mesa">Para mesa</option>
                    <option value="llevar">Para llevar</option>
                    <option value="domicilio">Domicilio</option>
                </select>

                <label for="cashier">Cajero responsable</label>
                <select id="cashier" required>
                    <option value="">Selecciona un cajero</option>
                    {% for cashier in cashiers %}
                        <option value="{{ cashier.id }}">{{ cashier.username }}</option>
                    {% endfor %}
                </select>

                <div id="table-fields">
                    <label for="table-number">Número de mesa</label>
                    <input id="table-number" type="text" maxlength="60" placeholder="Ej. 4">
                </div>

                <div id="delivery-fields" hidden>
                    <label for="customer-name">Nombre del cliente</label>
                    <input id="customer-name" type="text" maxlength="180">
                    <label for="customer-phone">Teléfono</label>
                    <input id="customer-phone" type="text" maxlength="40">
                    <label for="delivery-address">Dirección</label>
                    <input id="delivery-address" type="text" maxlength="255">
                </div>
            </div>
            <div id="cart-items" class="cart-items">
                <p id="cart-empty" class="empty-cart">Selecciona un producto o compuesto para comenzar.</p>
            </div>
            <div class="cart-footer">
                <div class="cart-total"><span>Total</span><strong id="cart-total">$ 0,00</strong></div>
                <p id="order-error" class="order-error" hidden></p>
                <button id="submit-order" class="button button-primary button-full" type="button" disabled>Ordenar</button>
            </div>
        </aside>
    </div>
</main>
{% endblock %}

{% block javascripts %}
<script>
    const cart = [];
    const currency = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 2 });
    const cartItems = document.getElementById('cart-items');
    const cartEmpty = document.getElementById('cart-empty');
    const cartCount = document.getElementById('cart-count');
    const cartTotal = document.getElementById('cart-total');
    const orderType = document.getElementById('order-type');
    const tableFields = document.getElementById('table-fields');
    const deliveryFields = document.getElementById('delivery-fields');
    const submitOrder = document.getElementById('submit-order');
    const orderError = document.getElementById('order-error');

    function renderCart() {
        cartItems.querySelectorAll('.cart-line').forEach((line) => line.remove());
        cartEmpty.hidden = cart.length > 0;
        let total = 0;

        cart.forEach((item, index) => {
            total += item.price * item.quantity;
            const line = document.createElement('div');
            line.className = 'cart-line';
            line.innerHTML = `<div><strong>${item.name}</strong><span>${currency.format(item.price)} × ${item.quantity}</span></div><button type="button" aria-label="Quitar ${item.name}" data-remove="${index}">×</button>`;
            cartItems.appendChild(line);
        });

        cartCount.textContent = cart.reduce((sum, item) => sum + item.quantity, 0);
        cartTotal.textContent = currency.format(total);
        submitOrder.disabled = cart.length === 0;
    }

    function updateDestinationFields() {
        const isTable = orderType.value === 'mesa';
        const isDelivery = orderType.value === 'domicilio';
        tableFields.hidden = !isTable;
        deliveryFields.hidden = !isDelivery;
    }

    orderType.addEventListener('change', updateDestinationFields);
    updateDestinationFields();

    document.querySelectorAll('[data-item-type]').forEach((button) => {
        button.addEventListener('click', () => {
            const item = cart.find((entry) => entry.type === button.dataset.itemType && entry.id === button.dataset.itemId);
            if (item) {
                item.quantity += 1;
            } else {
                cart.push({ type: button.dataset.itemType, id: button.dataset.itemId, name: button.dataset.itemName, price: Number(button.dataset.itemPrice), quantity: 1 });
            }
            renderCart();
        });
    });

    cartItems.addEventListener('click', (event) => {
        const removeButton = event.target.closest('[data-remove]');
        if (removeButton) {
            cart.splice(Number(removeButton.dataset.remove), 1);
            renderCart();
        }
    });

    submitOrder.addEventListener('click', async () => {
        orderError.hidden = true;
        submitOrder.disabled = true;

        const payload = {
            orderType: orderType.value,
            assignedCashierId: document.getElementById('cashier').value,
            tableNumber: document.getElementById('table-number').value,
            customerName: document.getElementById('customer-name').value,
            customerPhone: document.getElementById('customer-phone').value,
            deliveryAddress: document.getElementById('delivery-address').value,
            items: cart.map((item) => ({ type: item.type, id: item.id, quantity: item.quantity.toFixed(3) })),
        };

        try {
            const response = await fetch('/api/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.error || 'No fue posible crear la orden.');
            }

            cart.length = 0;
            renderCart();
            alert(`Orden #${result.orderNumber} enviada a preparación.`);
        } catch (error) {
            orderError.textContent = error.message;
            orderError.hidden = false;
            submitOrder.disabled = cart.length === 0;
        }
    });
</script>
{% endblock %}
