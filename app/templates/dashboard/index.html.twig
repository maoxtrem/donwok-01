{% extends 'base.html.twig' %}

{% block title %}Donwok | Panel operativo{% endblock %}

{% block body %}
<main class="dashboard-shell">
    <header class="dashboard-header">
        <div class="dashboard-brand">
            <div class="brand-mark brand-mark-mini">D</div>
            <span>Donwok</span>
        </div>
        <div class="dashboard-user">
            <span class="user-label">Sesión activa</span>
            <strong>{{ user.userIdentifier }}</strong>
            <a href="{{ path('app_logout') }}">Salir</a>
        </div>
    </header>

    <section class="dashboard-intro">
        <p class="eyebrow">Panel operativo</p>
        <h1>¿Qué necesitas hacer hoy?</h1>
        <p>Accede rápidamente al área de trabajo que corresponde a tu operación.</p>
    </section>

    <section class="dashboard-grid" aria-label="Áreas operativas">
        {% if can_sale %}<a class="dashboard-card dashboard-card-primary dashboard-card-link" href="{{ path('app_sale') }}">
            <span class="card-icon">＋</span>
            <div>
                <p class="card-kicker">Ventas</p>
                <h2>Crear una orden</h2>
                <p>Selecciona productos y compuestos para iniciar un pedido.</p>
            </div>
            <span class="card-status">Abrir menú</span>
        </a>{% endif %}

        {% if can_orders %}
        <article class="dashboard-card">
            <span class="card-icon">▣</span>
            <div>
                <p class="card-kicker">Seguimiento</p>
                <h2>Órdenes activas</h2>
                <p>Consulta el estado de preparación, facturación y entrega.</p>
            </div>
            <a class="card-status card-status-link" href="{{ path('app_orders') }}">Ver órdenes</a>
        </article>
        {% endif %}

        {% if can_kitchen %}
        <article class="dashboard-card">
            <span class="card-icon">⌁</span>
            <div>
                <p class="card-kicker">Producción</p>
                <h2>Cocina</h2>
                <p>Visualiza y procesa las comandas del restaurante.</p>
            </div>
            <div class="dashboard-card-actions">
                <a class="card-status card-status-link" href="{{ path('app_kitchen') }}">Vista móvil</a>
                <a class="card-status card-status-link" href="{{ path('app_kitchen_tv') }}" target="_blank" rel="noopener">Vista TV</a>
            </div>
        </article>
        {% endif %}

        {% if can_cashier %}<a class="dashboard-card dashboard-card-link" href="{{ path('app_cashier') }}">
            <span class="card-icon">$</span>
            <div>
                <p class="card-kicker">Operación financiera</p>
                <h2>Caja</h2>
                <p>Gestiona pagos, cajas y cierres según tus permisos.</p>
            </div>
            <span class="card-status">Abrir caja</span>
        </a>{% endif %}

        {% if can_cash %}
        <a class="dashboard-card dashboard-card-link" href="{{ path('app_cashier_finances') }}">
            <span class="card-icon">◫</span>
            <div>
                <p class="card-kicker">Control financiero</p>
                <h2>Cierre y movimientos</h2>
                <p>Consulta saldos, cajas asignadas y órdenes incluidas en el cierre.</p>
            </div>
            <span class="card-status">Ver resumen</span>
        </a>
        {% endif %}

        {% if can_receipts %}<a class="dashboard-card dashboard-card-link" href="{{ path('app_payment_receipts') }}">
            <span class="card-icon">▧</span>
            <div>
                <p class="card-kicker">Pagos</p>
                <h2>Cargar comprobantes</h2>
                <p>Usa el móvil para fotografiar los comprobantes pendientes.</p>
            </div>
            <span class="card-status">Abrir cámara</span>
        </a>{% endif %}
    </section>
</main>
{% endblock %}
