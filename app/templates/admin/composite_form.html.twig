{% extends 'base.html.twig' %}
{% block title %}Donwok | {{ new ? 'Crear compuesto' : 'Editar compuesto' }}{% endblock %}
{% block body %}
<main class="admin-shell">{% include 'admin/_sidebar.html.twig' with {user: user} %}<section class="admin-content"><header class="admin-content-header"><div><p class="eyebrow">Catálogo</p><h1>{{ new ? 'Crear compuesto' : 'Editar compuesto' }}</h1><p>El costo y el precio se calculan sumando los productos seleccionados.</p></div><a class="button button-secondary" href="{{ path('app_admin_composites') }}">Volver</a></header>{% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_composite') }}"><section class="admin-form-card"><div class="admin-form-grid"><div><label for="name">Nombre</label><input id="name" name="name" type="text" value="{{ composite.name }}" required maxlength="180"></div><div><label for="code">Código opcional</label><input id="code" name="code" type="text" value="{{ composite.code|default('') }}" maxlength="120"></div><div><label for="category">Categoría</label><select id="category" name="category"><option value="">Sin categoría</option>{% for category in categories %}<option value="{{ category.id }}"{% if composite.category and composite.category.id == category.id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div><div><label for="description">Descripción</label><input id="description" name="description" type="text" value="{{ composite.description|default('') }}" maxlength="255"></div><label class="admin-toggle"><input name="allowCustomization" type="checkbox"{% if new or composite.allowsCustomization %} checked{% endif %}><span>Permitir editar los componentes en Ventas</span></label><label class="admin-toggle"><input name="active" type="checkbox"{% if new or composite.active %} checked{% endif %}><span>Compuesto activo</span></label></div></section><section class="admin-form-card"><div class="admin-section-heading"><div><p class="eyebrow">Plantilla</p><h2>Componentes</h2></div><span class="admin-hint">La medida y el precio vienen del producto</span></div><div class="table-responsive"><table class="table table-hover align-middle admin-table mb-0"><thead><tr><th>Producto</th><th>Medida</th><th>Costo</th><th>Venta</th><th class="text-center">Incluir</th></tr></thead><tbody>{% for product in products %}<tr><td><strong>{{ product.name }}</strong></td><td>{{ product.measure }} {{ product.unit }}</td><td>$ {{ product.costPrice|number_format(2, ',', '.') }}</td><td>$ {{ product.salePrice|number_format(2, ',', '.') }}</td><td class="text-center"><input class="form-check-input permission-check" type="checkbox" name="components[]" value="{{ product.id }}"{% for component in composite.components %}{% if component.product.id == product.id %} checked{% endif %}{% endfor %}></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Crea primero un producto activo.</td></tr>{% endfor %}</tbody></table></div></section><div class="admin-form-actions"><a class="button button-secondary" href="{{ path('app_admin_composites') }}">Cancelar</a><button class="button button-primary" type="submit">Guardar compuesto</button></div></form></section></main>
{% endblock %}
