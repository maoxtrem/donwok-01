{% extends 'base.html.twig' %}
{% block title %}Donwok | Categorías{% endblock %}
{% block body %}
<main class="admin-shell"><aside class="admin-sidebar">
    <a class="admin-brand" href="{{ path('app_admin_dashboard') }}"><div class="brand-mark brand-mark-mini">D</div><span>Donwok</span></a>
    <div class="admin-profile"><span>Administrador</span><strong>{{ user.userIdentifier }}</strong></div>
    <nav class="admin-nav"><a class="admin-nav-item" href="{{ path('app_admin_dashboard') }}"><span>⌂</span> Inicio</a><a class="admin-nav-item" href="{{ path('app_admin_products') }}"><span>▦</span> Productos</a><a class="admin-nav-item" href="{{ path('app_admin_composites') }}"><span>◈</span> Compuestos</a><a class="admin-nav-item active" href="{{ path('app_admin_categories') }}"><span>▤</span> Categorías</a></nav>
    <a class="admin-logout" href="{{ path('app_logout') }}">↪ Cerrar sesión</a>
</aside><section class="admin-content">
    <header class="admin-content-header"><div><p class="eyebrow">Catálogo</p><h1>Categorías</h1><p>Organiza productos y compuestos en las pestañas de Ventas.</p></div><a class="button button-primary" href="{{ path('app_admin_category_new') }}">Crear categoría</a></header>
    <section class="admin-form-card admin-table-card"><div class="table-responsive"><table class="table table-hover align-middle admin-table mb-0"><thead><tr><th>Categoría</th><th>Posición</th><th class="text-end">Acciones</th></tr></thead><tbody>
    {% for category in categories %}<tr><td><strong>{{ category.name }}</strong></td><td>{{ category.position }}</td><td class="text-end"><a class="button button-secondary button-small" href="{{ path('app_admin_category_edit', {id: category.id}) }}">Editar</a></td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">No hay categorías.</td></tr>{% endfor %}
    </tbody></table></div></section>
</section></main>
{% endblock %}
