{% extends 'base.html.twig' %}

{% block title %}Donwok | Administración{% endblock %}

{% block body %}
<main class="admin-shell">
    {% include 'admin/_sidebar.html.twig' with {user: user} %}

    <section class="admin-content">
        <header class="admin-content-header">
            <div>
                <p class="eyebrow">Control total</p>
                <h1>Panel administrativo</h1>
                <p>Gestiona la operación completa de Donwok desde un solo lugar.</p>
            </div>
            <span class="admin-role-badge">ROLE_ADMIN</span>
        </header>

        <section class="admin-overview-grid" aria-label="Resumen administrativo">
            <article class="admin-overview-card admin-overview-accent">
                <span class="overview-icon">⌁</span>
                <p>Operación</p>
                <strong>Panel global</strong>
                <span>Acceso sin restricciones de grupo</span>
            </article>
            <article class="admin-overview-card">
                <span class="overview-icon">✓</span>
                <p>Seguridad</p>
                <strong>Administrador activo</strong>
                <span>{{ user.userIdentifier }}</span>
            </article>
            <article class="admin-overview-card">
                <span class="overview-icon">◷</span>
                <p>Estado</p>
                <strong>Sistema disponible</strong>
                <span>Servicios operativos</span>
            </article>
        </section>

        <section class="admin-welcome-card">
            <div>
                <p class="eyebrow">Siguiente paso</p>
                <h2>Las herramientas administrativas se habilitarán por módulo.</h2>
                <p>El administrador podrá operar todas las áreas sin depender de los grupos de permisos.</p>
            </div>
            <a class="button button-primary" href="{{ path('app_sale') }}">Abrir menú de venta</a>
        </section>
    </section>
</main>
{% endblock %}
