{% extends 'base.html.twig' %}

{% block title %}Donwok | Administración{% endblock %}

{% block body %}
<main class="admin-shell">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="{{ path('app_admin_dashboard') }}">
            <div class="brand-mark brand-mark-mini">D</div>
            <span>Donwok</span>
        </a>

        <div class="admin-profile">
            <span>Administrador</span>
            <strong>{{ user.userIdentifier }}</strong>
        </div>

        <nav class="admin-nav" aria-label="Navegación administrativa">
            <a class="admin-nav-item active" href="{{ path('app_admin_dashboard') }}"><span>⌂</span> Inicio</a>
            <a class="admin-nav-item" href="{{ path('app_sale') }}"><span>＋</span> Menú de venta</a>
            <a class="admin-nav-item" href="{{ path('app_dashboard') }}"><span>▣</span> Vista operativa</a>
            <a class="admin-nav-item" href="{{ path('api_health') }}"><span>◉</span> Estado del sistema</a>
        </nav>

        <div class="admin-nav-group">
            <p>Seguridad y acceso</p>
            <a class="admin-nav-item" href="{{ path('app_admin_groups') }}"><span>♧</span> Grupos</a>
            <a class="admin-nav-item" href="{{ path('app_admin_users') }}"><span>♙</span> Usuarios</a>
        </div>

        <div class="admin-nav-group">
            <p>Próximos módulos</p>
            <a class="admin-nav-item" href="{{ path('app_admin_products') }}"><span>▦</span> Productos</a>
            <a class="admin-nav-item" href="{{ path('app_admin_composites') }}"><span>◈</span> Compuestos</a>
            <a class="admin-nav-item" href="{{ path('app_admin_categories') }}"><span>▤</span> Categorías</a>
            <a class="admin-nav-item" href="{{ path('app_admin_print_templates') }}"><span>▧</span> Plantillas de impresión</a>
            <a class="admin-nav-item" href="{{ path('app_cashier') }}"><span>▣</span> Facturación</a>
            <a class="admin-nav-item" href="{{ path('app_kitchen') }}"><span>◫</span> Cocina</a>
            <a class="admin-nav-item" href="{{ path('app_admin_cashiers') }}"><span>▣</span> Módulos de pago</a>
            <a class="admin-nav-item" href="{{ path('app_admin_ledger') }}"><span>▤</span> Libro mayor</a>
            <a class="admin-nav-item" href="{{ path('app_admin_work_positions') }}"><span>◷</span> Puestos y turnos</a>
        </div>

        <a class="admin-logout" href="{{ path('app_logout') }}">↪ Cerrar sesión</a>
    </aside>

    <section class="admin-content">
        <header class="admin-content-header">
            <div>
                <p class="eyebrow">Control total</p>
                <h1>Panel administrativo</h1>
                <p>Gestiona la operación completa de Donwok desde un solo lugar.</p>
            </div>
            <span class="admin-role-badge">ROLE_ADMIN</span>
        </header>

        <section class="admin-overview-grid" aria-label="Resumen administrativo">
            <article class="admin-overview-card admin-overview-accent">
                <span class="overview-icon">⌁</span>
                <p>Operación</p>
                <strong>Panel global</strong>
                <span>Acceso sin restricciones de grupo</span>
            </article>
            <article class="admin-overview-card">
                <span class="overview-icon">✓</span>
                <p>Seguridad</p>
                <strong>Administrador activo</strong>
                <span>{{ user.userIdentifier }}</span>
            </article>
            <article class="admin-overview-card">
                <span class="overview-icon">◷</span>
                <p>Estado</p>
                <strong>Sistema disponible</strong>
                <span>Servicios operativos</span>
            </article>
        </section>

        <section class="admin-welcome-card">
            <div>
                <p class="eyebrow">Siguiente paso</p>
                <h2>Las herramientas administrativas se habilitarán por módulo.</h2>
                <p>El administrador podrá operar todas las áreas sin depender de los grupos de permisos.</p>
            </div>
            <a class="button button-primary" href="{{ path('app_sale') }}">Abrir menú de venta</a>
        </section>
    </section>
</main>
{% endblock %}
