{% extends 'base.html.twig' %}
{% block title %}Donwok | {{ new ? 'Crear producto' : 'Editar producto' }}{% endblock %}
{% block body %}
<main class="admin-shell"><aside class="admin-sidebar">
    <a class="admin-brand" href="{{ path('app_admin_dashboard') }}"><div class="brand-mark brand-mark-mini">D</div><span>Donwok</span></a><div class="admin-profile"><span>Administrador</span><strong>{{ user.userIdentifier }}</strong></div>
    <nav class="admin-nav"><a class="admin-nav-item" href="{{ path('app_admin_dashboard') }}"><span>⌂</span> Inicio</a><a class="admin-nav-item active" href="{{ path('app_admin_products') }}"><span>▦</span> Productos</a><a class="admin-nav-item" href="{{ path('app_admin_composites') }}"><span>◈</span> Compuestos</a><a class="admin-nav-item" href="{{ path('app_admin_groups') }}"><span>♧</span> Grupos</a><a class="admin-nav-item" href="{{ path('app_admin_users') }}"><span>♙</span> Usuarios</a></nav><a class="admin-logout" href="{{ path('app_logout') }}">↪ Cerrar sesión</a>
</aside><section class="admin-content"><header class="admin-content-header"><div><p class="eyebrow">Catálogo</p><h1>{{ new ? 'Crear producto' : 'Editar producto' }}</h1><p>La medida y los valores serán copiados al formar compuestos y pedidos.</p></div><a class="button button-secondary" href="{{ path('app_admin_products') }}">Volver</a></header>
{% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_product') }}"><section class="admin-form-card"><div class="admin-form-grid admin-catalog-grid"><div><label for="name">Nombre</label><input id="name" name="name" type="text" value="{{ product.name }}" required maxlength="180"></div><div><label for="code">Código opcional</label><input id="code" name="code" type="text" value="{{ product.code|default('') }}" maxlength="120"></div><div><label for="category">Categoría</label><select id="category" name="category"><option value="">Sin categoría</option>{% for category in categories %}<option value="{{ category.id }}"{% if product.category and product.category.id == category.id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div><div><label for="unit">Unidad</label><input id="unit" name="unit" type="text" value="{{ product.unit }}" required maxlength="30" placeholder="gramo, ml, unidad"></div><div><label for="measure">Medida/peso entero</label><input id="measure" name="measure" type="number" min="1" step="1" value="{{ product.measure }}" required></div><div><label for="costPrice">Costo</label><input id="costPrice" name="costPrice" type="text" value="{{ product.costPrice }}" required></div><div><label for="salePrice">Precio de venta</label><input id="salePrice" name="salePrice" type="text" value="{{ product.salePrice }}" required></div><div class="catalog-description"><label for="description">Descripción</label><input id="description" name="description" type="text" value="{{ product.description|default('') }}" maxlength="255"></div><label class="admin-toggle"><input name="active" type="checkbox"{% if new or product.active %} checked{% endif %}><span>Producto activo</span></label></div></section><div class="admin-form-actions"><a class="button button-secondary" href="{{ path('app_admin_products') }}">Cancelar</a><button class="button button-primary" type="submit">Guardar producto</button></div></form>
</section></main>
{% endblock %}
