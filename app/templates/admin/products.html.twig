{% extends 'base.html.twig' %}
{% block title %}Donwok | Productos{% endblock %}
{% block body %}
<main class="admin-shell"><aside class="admin-sidebar">
    <a class="admin-brand" href="{{ path('app_admin_dashboard') }}"><div class="brand-mark brand-mark-mini">D</div><span>Donwok</span></a>
    <div class="admin-profile"><span>Administrador</span><strong>{{ user.userIdentifier }}</strong></div>
    <nav class="admin-nav"><a class="admin-nav-item" href="{{ path('app_admin_dashboard') }}"><span>⌂</span> Inicio</a><a class="admin-nav-item active" href="{{ path('app_admin_products') }}"><span>▦</span> Productos</a><a class="admin-nav-item" href="{{ path('app_admin_composites') }}"><span>◈</span> Compuestos</a><a class="admin-nav-item" href="{{ path('app_admin_groups') }}"><span>♧</span> Grupos</a><a class="admin-nav-item" href="{{ path('app_admin_users') }}"><span>♙</span> Usuarios</a></nav>
    <a class="admin-logout" href="{{ path('app_logout') }}">↪ Cerrar sesión</a>
</aside><section class="admin-content">
    <header class="admin-content-header"><div><p class="eyebrow">Catálogo</p><h1>Productos</h1><p>Define medida, costo y precio de venta para cada producto.</p></div><div class="admin-form-actions"><a class="button button-secondary" href="{{ path('app_admin_categories') }}">Categorías</a><a class="button button-primary" href="{{ path('app_admin_product_new') }}">Crear producto</a></div></header>
    <section class="admin-form-card admin-table-card"><div class="table-responsive"><table class="table table-hover align-middle admin-table mb-0"><thead><tr><th>Producto</th><th>Medida</th><th>Costo</th><th>Venta</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
    {% for product in products %}<tr><td><strong>{{ product.name }}</strong><small class="d-block text-muted">{{ product.code|default('Sin código') }}</small></td><td>{{ product.measure }} {{ product.unit }}</td><td>$ {{ product.costPrice|number_format(0, ',', '.') }}</td><td><strong>$ {{ product.salePrice|number_format(0, ',', '.') }}</strong></td><td><span class="badge rounded-pill {{ product.active ? 'text-bg-success' : 'text-bg-secondary' }}">{{ product.active ? 'Activo' : 'Inactivo' }}</span></td><td class="text-end"><a class="button button-secondary button-small" href="{{ path('app_admin_product_edit', {id: product.id}) }}">Editar</a>{% if product.active %}<form class="d-inline" method="post" action="{{ path('app_admin_product_deactivate', {id: product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_deactivate_' ~ product.id) }}"><button class="button button-danger button-small" type="submit">Desactivar</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">No hay productos.</td></tr>{% endfor %}
    </tbody></table></div></section>
</section></main>
{% endblock %}
