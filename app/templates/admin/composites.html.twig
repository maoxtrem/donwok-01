{% extends 'base.html.twig' %}
{% block title %}Donwok | Compuestos{% endblock %}
{% block body %}
<main class="admin-shell">{% include 'admin/_sidebar.html.twig' with {user: user} %}<section class="admin-content"><header class="admin-content-header"><div><p class="eyebrow">Catálogo</p><h1>Compuestos</h1><p>Arma plantillas reutilizables a partir de productos del catálogo.</p></div><a class="button button-primary" href="{{ path('app_admin_composite_new') }}">Crear compuesto</a></header><section class="admin-form-card admin-table-card"><div class="table-responsive"><table class="table table-hover align-middle admin-table mb-0"><thead><tr><th>Compuesto</th><th>Componentes</th><th>Costo</th><th>Venta</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>{% for composite in composites %}<tr><td><strong>{{ composite.name }}</strong><small class="d-block text-muted">{{ composite.code|default('Sin código') }}</small></td><td>{% for component in composite.components %}<span class="badge rounded-pill text-bg-light me-1">{{ component.quantity }} {{ component.unit }} {{ component.product.name }}</span>{% endfor %}</td><td>$ {{ composite.costPrice|number_format(2, ',', '.') }}</td><td><strong>$ {{ composite.salePrice|number_format(2, ',', '.') }}</strong></td><td><span class="badge rounded-pill {{ composite.active ? 'text-bg-success' : 'text-bg-secondary' }}">{{ composite.active ? 'Activo' : 'Inactivo' }}</span></td><td class="text-end"><a class="button button-secondary button-small" href="{{ path('app_admin_composite_edit', {id: composite.id}) }}">Editar</a>{% if composite.active %}<form class="d-inline" method="post" action="{{ path('app_admin_composite_deactivate', {id: composite.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_composite_deactivate_' ~ composite.id) }}"><button class="button button-danger button-small" type="submit">Desactivar</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">No hay compuestos.</td></tr>{% endfor %}</tbody></table></div></section></section></main>
{% endblock %}
