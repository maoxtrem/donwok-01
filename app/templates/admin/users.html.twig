{% extends 'base.html.twig' %}

{% block title %}Donwok | Usuarios{% endblock %}

{% block body %}
<main class="admin-shell">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="{{ path('app_admin_dashboard') }}"><div class="brand-mark brand-mark-mini">D</div><span>Donwok</span></a>
        <div class="admin-profile"><span>Administrador</span><strong>{{ user.userIdentifier }}</strong></div>
        <nav class="admin-nav" aria-label="Navegación administrativa">
            <a class="admin-nav-item" href="{{ path('app_admin_dashboard') }}"><span>⌂</span> Inicio</a>
            <a class="admin-nav-item" href="{{ path('app_admin_groups') }}"><span>♧</span> Grupos</a>
            <a class="admin-nav-item active" href="{{ path('app_admin_users') }}"><span>♙</span> Usuarios</a>
            <a class="admin-nav-item" href="{{ path('app_admin_products') }}"><span>▦</span> Productos</a>
            <a class="admin-nav-item" href="{{ path('app_admin_composites') }}"><span>◈</span> Compuestos</a>
        </nav>
        <a class="admin-logout" href="{{ path('app_logout') }}">↪ Cerrar sesión</a>
    </aside>
    <section class="admin-content">
        <header class="admin-content-header">
            <div><p class="eyebrow">Seguridad y acceso</p><h1>Usuarios</h1><p>Administra las cuentas y sus grupos de permisos.</p></div>
            <a class="button button-primary" href="{{ path('app_admin_user_new') }}">Crear usuario</a>
        </header>
        <section class="admin-form-card admin-table-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-table mb-0">
                    <thead><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th>Grupos</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                    {% for account in users %}
                        <tr>
                            <td><strong>{{ account.username }}</strong></td>
                            <td><span class="badge rounded-pill {{ 'ROLE_ADMIN' in account.roles ? 'text-bg-dark' : 'text-bg-light' }}">{{ 'ROLE_ADMIN' in account.roles ? 'ADMIN' : 'USER' }}</span></td>
                            <td><span class="badge rounded-pill {{ account.active ? 'text-bg-success' : 'text-bg-secondary' }}">{{ account.active ? 'Activo' : 'Inactivo' }}</span></td>
                            <td>{% if account.permissionGroups|length %}{{ account.permissionGroups|map(group => group.name)|join(', ') }}{% else %}<span class="text-muted">Sin grupos</span>{% endif %}</td>
                            <td class="text-end"><a class="button button-secondary button-small" href="{{ path('app_admin_user_edit', {id: account.id}) }}">Editar</a>{% if account.active and account != user %}<form class="d-inline" method="post" action="{{ path('app_admin_user_deactivate', {id: account.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_user_deactivate_' ~ account.id) }}"><button class="button button-danger button-small" type="submit">Desactivar</button></form>{% endif %}</td>
                        </tr>
                    {% else %}<tr><td colspan="5" class="text-center text-muted py-4">No hay usuarios.</td></tr>{% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </section>
</main>
{% endblock %}
