{% extends 'base.html.twig' %}

{% block title %}Donwok | Inicio{% endblock %}

{% block body %}
<main class="landing-shell">
    <section class="landing-card" aria-labelledby="landing-title">
        <div class="brand-lockup"><div class="brand-mark">D</div><span>Donwok</span></div>
        <p class="eyebrow">Gestión de pedidos</p>
        <h1 id="landing-title">Bienvenido a Donwok.</h1>
        <p class="landing-copy">
            Gestiona pedidos, cocina y caja desde una plataforma sencilla para tu equipo.
        </p>
        <div class="landing-actions">
            <a class="button button-primary" href="{{ path('app_login') }}">Iniciar sesión</a>
            <a class="button button-secondary" href="{{ path('app_work_shifts') }}">Turnos de trabajo</a>
        </div>
    </section>
</main>
{% endblock %}
